<Window x:Class="MediaOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MediaOverlay"
        mc:Ignorable="d"
        Title="Media Overlay" Height="120" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False">
    <Window.Resources>
        <Storyboard x:Key="PopAndGlowStoryboard">
            <!-- Slide Up -->
            <!-- <DoubleAnimation Storyboard.TargetName="TranslateTransform" -->
            <!--                  Storyboard.TargetProperty="Y" -->
            <!--                  From="50" To="0" Duration="0:0:0.4"> -->
            <!--     <DoubleAnimation.EasingFunction> -->
            <!--         <CubicEase EasingMode="EaseOut"/> -->
            <!--     </DoubleAnimation.EasingFunction> -->
            <!-- </DoubleAnimation> -->

            <!-- Card Fade In -->
            <DoubleAnimation Storyboard.TargetName="CardContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>

            <!-- Card Fade Out after 4 seconds -->
            <!-- <DoubleAnimation Storyboard.TargetName="CardContainer" -->
            <!--                  Storyboard.TargetProperty="Opacity" -->
            <!--                  From="1" To="0" BeginTime="0:0:4.0" Duration="0:0:0.5"/> -->
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Border x:Name="CardContainer"
                        CornerRadius="8"
                        Margin="15"
                        Opacity="1">
            
            <!-- <Border.RenderTransform> -->
            <!--     <TranslateTransform x:Name="TranslateTransform" Y="50"/> -->
            <!-- </Border.RenderTransform> -->

            <Grid>
                <Border x:Name="MaskBorder" Background="White" CornerRadius="8" />
                <Grid ClipToBounds="True" x:Name="BackgroundGrid">
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=MaskBorder}" Stretch="None" />
                    </Grid.OpacityMask>
                    <Rectangle Margin="-30">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="BackgroundImage" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="30" RenderingBias="Performance"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <Border Background="#A0121216"/>
                </Grid>
                <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Album Art -->
                <Border x:Name="AlbumArtBorder" Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="#282828">
                    <Rectangle RadiusX="4" RadiusY="4">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>

                <!-- Track Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" 
                               Text="Track Title" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="16" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" 
                               Text="Artist Name" 
                               Foreground="#A0A0A0" 
                               FontSize="12" 
                               Margin="0,3,0,0" 
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <Border x:Name="OverlayBorder" CornerRadius="8" BorderThickness="1" BorderBrush="#404040" />
            </Grid>
        </Border>
    </Grid>
</Window>
